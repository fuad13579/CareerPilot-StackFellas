# CareerPilot backend environment variables
# Copy this file to `.env` and fill in real values. The real `.env` is git-ignored.

# ---------------------------------------------------------------------------
# AI provider chain
# CareerPilot will use the first provider that is configured.
# Priority: GitHub Models -> OpenRouter -> rule-based CV/RAG fallback.
# Ollama / local LLM support has been removed.
# ---------------------------------------------------------------------------

# Option 1: GitHub Models (https://github.com/marketplace/models)
# Recommended. Uses a personal access token (PAT) with the "models: read" scope.
GITHUB_MODELS_TOKEN=your_github_models_token_here
GITHUB_MODELS_MODEL=openai/gpt-4o

# Option 2: OpenRouter (https://openrouter.ai)
# Fallback if GitHub Models is not configured. `openrouter/auto` lets OpenRouter
# pick the best model for the request.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto

# Optional: identify CareerPilot in OpenRouter analytics
OPENROUTER_APP_NAME=CareerPilot
OPENROUTER_APP_URL=https://careerpilot.local

# ---------------------------------------------------------------------------
# CORS
# Comma-separated list of origins allowed to call the API.
# Use "*" for fully open (credentials disabled).
# Default for local frontend development:
#   http://localhost:3000,http://127.0.0.1:3000
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Existing application settings (kept for reference)
# ---------------------------------------------------------------------------

# Upload response toggles
# INCLUDE_EXTRACTED_TEXT_IN_UPLOAD_RESPONSE=true

# Fit score engine
# FIT_SCORE_SKILL_WEIGHT=0.75
# FIT_SCORE_KEYWORD_WEIGHT=0.25
# FIT_SCORE_COMMON_SKILLS=python,javascript,react,node,sql,aws,docker
